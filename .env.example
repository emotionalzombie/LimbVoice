# ── Копировать в .env и заполнить ──────────────────────────────────────────

# База данных
POSTGRES_USER=limbvoice
POSTGRES_PASSWORD=limbvoice
POSTGRES_DB=limbvoice

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

# FastAPI
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_PREFIX=/api/v1
DEBUG=true

# Медиафайлы
MEDIA_DIR=/app/media
MEDIA_BASE_URL=http://localhost:8000/media

# TTS
TTS_BACKEND=mock          # mock | silero | qwen3
TTS_VOICE=sevastopol_v1
TTS_SPEED=1.0
